; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dragon Inspection - Town"
run/main_scene="res://game.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Atmosphere="*res://scripts/env.gd"
RegionState="*res://scripts/region_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"

[rendering]

; The target integrated GPU performs better with Compatibility. Forward+ can
; still be selected with --rendering-method forward_plus before the -- separator.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.07, 1)

[physics]

common/max_physics_steps_per_frame=4
