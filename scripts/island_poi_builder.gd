var map: Node3D
var tc: Node
var built := 0
var counts := {}
var _placed: Array = []

func build(m: Node3D, terrain_collision: Node) -> void:
	map = m
	tc = terrain_collision
	for isl in ISLANDS:
		var n := 0
		for p in isl["pois"]:
			var spot := _find_spot(isl["cx"] + float(p["dx"]), isl["cz"] + float(p["dz"]))
			if spot.y < -1.0e20:
				push_warning("POI: no ground for island %s %s" % [isl["id"], p["name"]])
				continue
			_make_root(int(isl["id"]), String(p["kind"]), String(p["name"]), spot)
			n += 1
			built += 1
		counts[int(isl["id"])] = n
	print("POI_BUILD total=%d %s" % [built, str(counts)])

func _find_spot(x: float, z: float) -> Vector3:
	# Use a connected walkable component, not a nearest-flat search: thin
	# islands have detached shelves 3-5 m away that look flat but cannot be
	# walked to.  A 0.6 m grid BFS with a 0.55 m step limit keeps every POI on
	# the same walkable land mass as the requested island centre.
	var step := 0.6
	var cells := {}
	for ix in range(-11, 12):
		for iz in range(-11, 12):
			var px := x + float(ix) * step
			var pz := z + float(iz) * step
			var h: float = tc.call("walkable_height", px, pz)
			if is_nan(h) or h < -6.0:
				continue
			if map.has_method("_is_water") and bool(map.call("_is_water", Vector3(px,h,pz))):
				continue
			# walkable_height() searches outward from a hole/steep cell.  Its
			# returned height is valid, but px/pz may still be a void hole: four
			# POIs were placed over the underside with ~25 m of clearance.  Require
			# an actual top-terrain ray at the exact cell before accepting it.
			if map.has_method("_terrain_y"):
				var top_y: float = float(map.call("_terrain_y", px, pz))
				if absf(top_y - h) > 0.35:
					continue
			cells[Vector2i(ix,iz)] = h
	if cells.is_empty():
		return Vector3(0.0, -1.0e30, 0.0)
	# Nearest valid cell to the requested point seeds the component.
	var seed := Vector2i(999,999)
	var best := 1.0e20
	for k in cells.keys():
		var d := float(k.x*k.x + k.y*k.y)
		if d < best:
			best = d; seed = k
	var comp: Array = []
	var seen := {seed: true}
	var queue: Array = [seed]
	while not queue.is_empty():
		var c: Vector2i = queue.pop_front()
		comp.append(c)
		var hc: float = float(cells[c])
		for off in [Vector2i(1,0),Vector2i(-1,0),Vector2i(0,1),Vector2i(0,-1)]:
			var n: Vector2i = c + off
			if seen.has(n) or not cells.has(n):
				continue
			if absf(float(cells[n]) - hc) > 0.55:
				continue
			seen[n] = true
			queue.append(n)
	# Nearest candidate in the component, avoiding other POI footprints.
	var out := Vector3(0.0, -1.0e30, 0.0)
	var best_score := 1.0e20
	var fallback := Vector3.ZERO
	for c in comp:
		var px: float = x + float(c.x) * step
		var pz: float = z + float(c.y) * step
		var h: float = float(cells[c])
		var d := Vector2(float(c.x), float(c.y)).length()
		# Local roughness: prefer a patch where the four grid neighbours agree.
		var rough := 0.0
		for off in [Vector2i(1,0),Vector2i(-1,0),Vector2i(0,1),Vector2i(0,-1)]:
			if cells.has(c + off):
				rough = maxf(rough, absf(float(cells[c + off]) - h))
		var clear := true
		for q in _placed:
			if Vector2(px-float(q[0]), pz-float(q[1])).length() < 3.1:
				clear = false
				break
		if not clear:
			continue
		var score := d + rough * 5.0
		if score < best_score:
			best_score = score
			out = Vector3(px, h, pz)
		if fallback == Vector3.ZERO:
			fallback = Vector3(px, h, pz)
	if out != Vector3(0.0, -1.0e30, 0.0):
		return out
	return fallback


func _make_root(id: int, kind: String, nm: String, pos: Vector3) -> void:
	var root := Node3D.new()
	root.name = "Prop_POI_%02d_%s" % [id, nm]
	map.add_child(root)
	root.global_position = pos + Vector3(0, 0.01, 0)
	_placed.append(Vector2(pos.x, pos.z))
	root.set_meta("poi_id", "%02d_%s" % [id, nm])
	root.set_meta("poi_kind", kind)
	var area := Area3D.new()
	area.name = "POI_Trigger"
	area.collision_layer = 0
	area.collision_mask = 0
	area.set_meta("poi_id", root.get_meta("poi_id"))
	var sphere := SphereShape3D.new()
	sphere.radius = 4.2
	var cs := CollisionShape3D.new()
	cs.shape = sphere
	area.add_child(cs)
	root.add_child(area)
	match kind:
		"camp": _camp(root)
		"shrine": _shrine(root)
		"stones": _stones(root)
		"ruins": _ruins(root)
		"ore": _ore(root)
		"watch": _watch(root)
		"beacon": _beacon(root)
		"harvest": _harvest(root)
	# The POIs were authored with raw white marble / white mat_stone and the
	# generic red-brown camp wood, none of which go through the village
	# palette.  Fold their stone and timber into the established bands before
	# collision is generated.  POI_OLD=1 keeps the old look for A/B captures.
	if OS.get_environment("POI_OLD") != "1":
		_apply_poi_stone(root)
		# Camp crates, carts and woodpiles are the same Kenney props the village
		# uses.  Give them the village timber overlay before the palette pass so
		# they land on the accepted 31 deg timber, not the red raw `wood` slot.
		for n0 in root.find_children("prop_*", "Node3D", true, false):
			var model := String(n0.name)
			if model.begins_with("prop_crate") or model.begins_with("prop_woodpile") \
					or model.begins_with("prop_hay_cart") or model.begins_with("prop_bench"):
				PropSurface.apply_village(n0, model)
		VillagePalette.apply(root)
		# Run the timber overlay again after the palette: the palette converts
		# the crate's shared wood slot to palette_surface, and the first pass
		# would otherwise be undone.
		for n0 in root.find_children("prop_*", "Node3D", true, false):
			var model := String(n0.name)
			if model.begins_with("prop_crate") or model.begins_with("prop_woodpile") \
					or model.begins_with("prop_hay_cart") or model.begins_with("prop_bench"):
				PropSurface.apply_village(n0, model)
	map.call("_add_prop_collision", root, "poi_%s" % kind)

func _apply_poi_stone(root: Node3D) -> void:
	# mat_stone/mat_marble are authored pure white in the source GLBs.  The
	# prop stone branch is lit and bleached to near-white in direct sun, so use
	# the same unlit stone palette as the village buildings instead.
	var stone := VillagePalette.material("stone")
	for m0 in root.find_children("*", "MeshInstance3D", true, false):
		var mi := m0 as MeshInstance3D
		if mi.mesh == null:
			continue
		var stone_mesh := false
		for s in mi.mesh.get_surface_count():
			var src := mi.get_active_material(s) as StandardMaterial3D
			if src == null:
				continue
			var slot := String(src.resource_name).get_slice(".", 0).to_lower()
			if slot == "mat_stone" or slot == "mat_marble" or slot == "stone":
				stone_mesh = true
				break
		# material_override, not per-surface override: Arch_Marble_S and the
		# slab have several surfaces and the non-marble ones were still the
		# GLB's untextured white.
		if stone_mesh or String(mi.name) == "Menhir":
			mi.material_override = stone


func _model(root: Node3D, model: String, pos: Vector3, yaw := 0.0, scl := 1.0) -> Node3D:
	var direct := "res://assets/models/%s.glb" % model
	var flat := "res://assets/models/%s.glb" % model.replace("/", "_")
	var packed := load(direct if ResourceLoader.exists(direct) else flat) as PackedScene
	if packed == null:
		push_warning("POI missing model " + model)
		return null
	var inst := packed.instantiate() as Node3D
	if inst == null:
		return null
	inst.name = model.get_file().get_basename()
	inst.position = pos
	inst.rotation.y = yaw
	inst.scale = Vector3(scl, scl, scl)
	root.add_child(inst)
	return inst

func _light(root: Node3D, pos: Vector3, col: Color, energy: float, rng: float) -> void:
	var l := OmniLight3D.new()
	l.name = "POILight"
	l.position = pos
	l.light_color = col
	l.light_energy = energy
	l.omni_range = rng
	l.omni_attenuation = 1.6
	l.shadow_enabled = false
	root.add_child(l)

func _stone_mat(col: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = col
	m.roughness = 0.92
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	# Named so VillagePalette.apply() folds every hand-rolled menhir, ring and
	# obelisk into the same warm grey-tan stone as the village.
	m.resource_name = "stone"
	return m

func _canvas_mat(col: Color) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = col
	m.roughness = 0.98
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	return m

func _cloth_mat(col: Color, sway := 0.0, hem := 0.0) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/cloth.gdshader")
	m.set_shader_parameter("cloth_color", col)
	m.set_shader_parameter("sway_amount", sway)
	m.set_shader_parameter("hem_amount", hem)
	m.set_shader_parameter("seed", float(col.r * 13.7 + col.g * 7.1 + col.b * 3.3))
	return m

func _tent(root: Node3D, pos: Vector3, yaw := 0.0) -> void:
	var tent := Node3D.new()
	tent.name = "Tent"
	tent.position = pos
	tent.rotation.y = yaw
	root.add_child(tent)
	var pm := PrismMesh.new()
	pm.size = Vector3(2.6, 1.85, 3.2)
	var mi := MeshInstance3D.new()
	mi.name = "Canvas"
	mi.mesh = pm
	mi.position.y = 0.93
	mi.material_override = _cloth_mat(Color(0.54, 0.13, 0.16), 0.0, 0.0)
	tent.add_child(mi)
	var opening := MeshInstance3D.new()
	opening.name = "Opening"
	var bm := BoxMesh.new()
	bm.size = Vector3(0.92, 1.02, 0.04)
	opening.mesh = bm
	opening.position = Vector3(0, 0.52, 1.605)
	opening.material_override = _canvas_mat(Color(0.055, 0.035, 0.03))
	tent.add_child(opening)
	var pole := MeshInstance3D.new()
	pole.name = "RidgePole"
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.035
	cyl.bottom_radius = 0.045
	cyl.height = 3.45
	pole.mesh = cyl
	pole.rotation.x = PI * 0.5
	pole.position.y = 1.86
	pole.material_override = _stone_mat(Color(0.18, 0.12, 0.07))
	tent.add_child(pole)

func _campfire(root: Node3D, pos: Vector3) -> void:
	var fire := Node3D.new()
	fire.name = "Campfire"
	fire.position = pos
	root.add_child(fire)
	var ring := MeshInstance3D.new()
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.42
	cyl.bottom_radius = 0.48
	cyl.height = 0.16
	ring.mesh = cyl
	ring.position.y = 0.08
	ring.material_override = _stone_mat(Color(0.22, 0.19, 0.16))
	fire.add_child(ring)
	var flame := MeshInstance3D.new()
	var cone := CylinderMesh.new()
	cone.top_radius = 0.0
	cone.bottom_radius = 0.25
	cone.height = 0.75
	flame.mesh = cone
	flame.position.y = 0.50
	var fm := StandardMaterial3D.new()
	fm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	fm.albedo_color = Color(1.0, 0.45, 0.08)
	fm.emission_enabled = true
	fm.emission = Color(1.0, 0.32, 0.04)
	fm.emission_energy_multiplier = 2.4
	flame.material_override = fm
	fire.add_child(flame)
	_light(fire, Vector3(0, 0.7, 0), Color(1.0, 0.48, 0.14), 1.5, 5.2)

func _camp(root: Node3D) -> void:
	_tent(root, Vector3(0, 0, 0.0))
	_model(root, "props/prop_crate", Vector3(1.9, 0, 0.9), 0.3, 1.0)
	_model(root, "props/prop_barrel", Vector3(-1.65, 0, 0.65), 0.0, 1.0)
	_model(root, "props/prop_barrel_stack", Vector3(-1.9, 0, -0.5), 0.4, 0.9)
	_model(root, "props/prop_lantern_post", Vector3(2.0, 0, -1.1), 0.0, 0.9)
	_model(root, "props/prop_woodpile", Vector3(-2.1, 0, 1.4), 0.2, 0.8)
	_campfire(root, Vector3(0, 0, -1.8))
	_banner(root, Vector3(-2.6, 0, -1.2), Color(0.55, 0.34, 0.30))

func _shrine(root: Node3D) -> void:
	_model(root, "ruins/arch_marble_s", Vector3(0, 0, 0), 0.0, 1.0)
	_model(root, "ruins/column_standing", Vector3(-1.35, 0, -0.8), 0.0, 0.85)
	_model(root, "ruins/column_standing", Vector3(1.35, 0, -0.8), 0.0, 0.85)
	_model(root, "ruins/slab_mossy_l", Vector3(0, 0, 0.4), 0.0, 0.65)
	_model(root, "crystals2/crystal_flame", Vector3(0, 0.38, 0.4), 0.0, 1.15)
	_model(root, "plants/fern_teal_s", Vector3(-1.6, 0, 1.0), 0.0, 1.2)
	_banner(root, Vector3(-2.1, 0, 1.5), Color(0.22, 0.32, 0.48))
	_light(root, Vector3(0, 1.4, 0.4), Color(0.25, 0.75, 1.0), 0.0, 6.5)

func _menhir(root: Node3D, pos: Vector3, h: float, yaw := 0.0, tint := Color(0.30,0.34,0.31)) -> void:
	var mi := MeshInstance3D.new()
	mi.name = "Menhir"
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.20
	cyl.bottom_radius = 0.52
	cyl.height = h
	cyl.radial_segments = 7
	mi.mesh = cyl
	mi.position = pos + Vector3(0, h * 0.5, 0)
	mi.rotation = Vector3(0.035 * sin(yaw * 2.3), yaw, 0.028 * cos(yaw * 1.7))
	mi.material_override = _stone_mat(tint)
	root.add_child(mi)

func _obelisk(root: Node3D, pos: Vector3) -> void:
	var mi := MeshInstance3D.new()
	mi.name = "Runestone"
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.20
	cyl.bottom_radius = 0.58
	cyl.height = 5.2
	cyl.radial_segments = 6
	mi.mesh = cyl
	mi.position = pos + Vector3(0, 2.6, 0)
	mi.material_override = _stone_mat(Color(0.24,0.27,0.25))
	root.add_child(mi)
	var band := MeshInstance3D.new()
	band.name = "Runeband"
	var tor := TorusMesh.new()
	tor.inner_radius = 0.30
	tor.outer_radius = 0.42
	band.mesh = tor
	band.position = pos + Vector3(0, 3.9, 0)
	var bm := StandardMaterial3D.new()
	bm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	bm.albedo_color = Color(0.25, 0.85, 1.0)
	bm.emission_enabled = true
	bm.emission = Color(0.15, 0.62, 1.0)
	bm.emission_energy_multiplier = 2.2
	band.material_override = bm
	# A thin rune band alone reads as a gold ring floating over the void from
	# the inspection camera.  It is not a gameplay marker, so do not render it.
	band.visible = false
	root.add_child(band)
	_light(root, pos + Vector3(0,4.0,0), Color(0.2,0.8,1.0), 1.6, 8.0)

func _banner(root: Node3D, pos: Vector3, col: Color, h := 4.8) -> void:
	var pole := MeshInstance3D.new()
	pole.name = "BannerPole"
	var cyl := CylinderMesh.new()
	cyl.top_radius = 0.045
	cyl.bottom_radius = 0.075
	cyl.height = h
	pole.mesh = cyl
	pole.position = pos + Vector3(0, h*0.5, 0)
	pole.material_override = _stone_mat(Color(0.18,0.13,0.08))
	root.add_child(pole)
	var flag := MeshInstance3D.new()
	flag.name = "Banner"
	var bm := PlaneMesh.new()
	bm.size = Vector2(1.35, 0.72)
	bm.subdivide_width = 8
	bm.subdivide_depth = 4
	bm.orientation = PlaneMesh.FACE_Z
	flag.mesh = bm
	flag.position = pos + Vector3(0.67, h-0.48, 0)
	flag.material_override = _cloth_mat(col, 0.220, 1.0)
	root.add_child(flag)

func _stones(root: Node3D) -> void:
	for i in 5:
		var a := TAU * float(i) / 5.0
		_menhir(root, Vector3(cos(a) * 2.2, 0, sin(a) * 2.2),
			1.9 + 0.35 * float(i % 3), a, Color(0.29,0.33,0.30))
	_obelisk(root, Vector3(0, 0, 0))
	_model(root, "rocks/boulder_s", Vector3(1.5, 0, 0.2), 0.0, 1.0)
	_light(root, Vector3(0, 1.2, 0), Color(0.25, 0.65, 1.0), 1.2, 6.0)

func _ruins(root: Node3D) -> void:
	_model(root, "ruins/column_broken", Vector3(-1.25, 0, 0.4), 0.2, 1.0)
	_model(root, "ruins/column_broken", Vector3(1.3, 0, -0.35), -0.35, 0.85)
	_model(root, "ruins/rubble_l", Vector3(0.0, 0, 0.85), 0.4, 0.9)
	_model(root, "ruins/rubble_m", Vector3(-1.8, 0, -1.0), 0.0, 1.0)
	_model(root, "ruins/slab_mossy_l", Vector3(0.2, 0, -0.7), 0.25, 0.7)
	_menhir(root, Vector3(-2.3, 0, 1.8), 3.6, 0.4, Color(0.36,0.35,0.30))
	_banner(root, Vector3(2.3, 0, -1.9), Color(0.22, 0.32, 0.48), 4.4)

func _ore(root: Node3D) -> void:
	_model(root, "crystal_cluster/crystal_large", Vector3(0, 0, 0), 0.0, 1.15)
	_model(root, "crystal_cluster/crystal_medium", Vector3(1.2, 0, -0.8), 0.0, 1.1)
	_model(root, "rocks/boulder_s", Vector3(-1.5, 0, 0.4), 0.0, 1.2)
	_model(root, "props/prop_crate", Vector3(1.4, 0, 1.0), 0.4, 0.85)
	_model(root, "props/prop_barrel", Vector3(-1.45, 0, -1.05), 0.0, 0.9)
	_model(root, "crystal_cluster/crystal_large", Vector3(0.0, 0, 0.45), 0.4, 1.55)
	_banner(root, Vector3(-2.2, 0, 1.3), Color(0.22, 0.32, 0.48), 4.2)
